{
  "name": "interactive-calendar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "test": "DISABLE_AUTO_LISTEN=1 tsx tests/verify.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:install": "bash tests/install-sim.sh",
    "check": "npm run lint && npm test && npm run test:install && npm run build",
    "docker:build": "docker build -t interactive-calendar:local .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
