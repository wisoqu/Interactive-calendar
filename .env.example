# Порт и режим работы сервера / Server Port & Environment
NODE_ENV=production
PORT=3000

# Путь к файлу базы данных SQLite / SQLite Database File Path
# При запуске в Docker монтируется директория ./data -> /app/data
SQLITE_DB_PATH=./data/calendar_db.sqlite

# Настройки SMTP для отправки кодов восстановления пароля (необязательно)
# Если оставить SMTP_HOST пустым, отправка писем будет отключена.
# Для Gmail обязательно используйте «Пароль приложения» (App Password), а не обычный пароль!
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Школьный календарь <no-reply@example.com>"
SMTP_SECURE=false
