# Режим работы и порт сервера / Server Environment & Port
# Для локальной разработки используйте development; в Docker и install.sh выставляется production.
NODE_ENV=development
PORT=3000

# Интерфейс привязки опубликованного порта в Docker (используется docker-compose.yml)
# 0.0.0.0 — доступ по IP:3000, 127.0.0.1 — только через Nginx/HTTPS.
BIND_HOST=0.0.0.0

# Адрес, на котором слушает сам Node.js-процесс (обычно менять не нужно).
# В Docker всегда оставляйте 0.0.0.0, иначе опубликованный порт не достучится до контейнера.
LISTEN_HOST=0.0.0.0

# Доверять ли заголовкам X-Forwarded-* от обратного прокси.
# 1 (по умолчанию) — приложение за Nginx (HTTPS, корректный IP для rate limit).
# 0 — приложение открыто напрямую по IP:3000 (защита от подмены X-Forwarded-For).
TRUST_PROXY=1

# Путь к файлу базы данных SQLite / SQLite Database File Path
# При запуске в Docker монтируется директория ./data -> /app/data
SQLITE_DB_PATH=./data/calendar_db.sqlite

# Необязательная настройка лимитов запросов (скользящее окно), значений по умолчанию достаточно.
# Увеличьте, если вся школа выходит в интернет через один NAT и лимиты мешают.
#RATE_LIMIT_LOGIN_MAX=20
#RATE_LIMIT_REGISTER_MAX=50
#RATE_LIMIT_RESET_REQUEST_MAX=5
#RATE_LIMIT_RESET_CONFIRM_MAX=15
#RATE_LIMIT_JOIN_MAX=25

# Настройки SMTP для отправки кодов восстановления пароля (необязательно)
# Если оставить SMTP_HOST пустым, отправка писем будет отключена.
# Для Gmail обязательно используйте «Пароль приложения» (App Password), а не обычный пароль!
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Школьный календарь <no-reply@example.com>"
SMTP_SECURE=false
